{
  "info": {
    "name": "UrbanFix API — Complete Collection",
    "_postman_id": "urbanfix-0001",
    "description": "Colección completa de pruebas para UrbanFix API - Sistema de reportes urbanos. Verifica autenticación, autorización por roles, validaciones y todos los endpoints.\n\nCómo usarla:\n1. Levanta tu API (por defecto http://localhost:8080)\n2. Importa esta colección y el environment UrbanFix.postman_environment.json\n3. Corre la colección completa con Collection Runner en orden\n4. Revisa los test results para ver qué se está validando\n\nRoles soportados: CIUDADANO, ADMIN_MUNICIPAL, TECNICO, SUPERVISOR, OPERADOR, AUDITOR",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "ciudadanoEmail", "value": "" },
    { "key": "ciudadanoPassword", "value": "" },
    { "key": "adminEmail", "value": "" },
    { "key": "adminPassword", "value": "" },
    { "key": "tecnicoEmail", "value": "" },
    { "key": "tecnicoPassword", "value": "" },
    { "key": "supervisorEmail", "value": "" },
    { "key": "supervisorPassword", "value": "" },
    { "key": "categoriaId", "value": "" },
    { "key": "zonaId", "value": "" },
    { "key": "reporteId", "value": "" },
    { "key": "comentarioId", "value": "" },
    { "key": "uniqueSuffix", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('uniqueSuffix')) {",
          "    pm.collectionVariables.set('uniqueSuffix', Date.now().toString());",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Setup - Crear Usuarios por Rol",
      "item": [
        {
          "name": "0.1 Registrar CIUDADANO",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = pm.collectionVariables.get('uniqueSuffix');",
                  "pm.collectionVariables.set('ciudadanoEmail', `ciudadano.${suffix}@urbanfix.com`);",
                  "pm.collectionVariables.set('ciudadanoPassword', 'Ciudadano123');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[0.1] Registro CIUDADANO responde 200/201', function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Ciudadano\",\n  \"email\": \"{{ciudadanoEmail}}\",\n  \"password\": \"{{ciudadanoPassword}}\"\n}"
