DB_HOST=localhost
DB_PORT=5432
DB_NAME=urbanfix
DB_USER=urbanfix_user
DB_PASSWORD=urbanfix_local_pass

# JWT
# Clave HMAC en Base64 (mín. 32 bytes decodificados). Ejemplo: openssl rand -base64 32
JWT_SECRET=your_base64_encoded_jwt_secret
JWT_EXPIRATION_ACCESS=900000
JWT_EXPIRATION_REFRESH=604800000

# Password Reset
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=15

# Admin Inicial (se crea automáticamente al iniciar la aplicación si no existe)
# CAMBIAR ESTAS CREDENCIALES EN PRODUCCIÓN
ADMIN_EMAIL=admin@urbanfix.com
ADMIN_PASSWORD=Admin123!
ADMIN_NOMBRE=Admin
ADMIN_APELLIDO=Municipal

# Mail Configuration (PRODUCCIÓN - Brevo, antes Sendinblue)
# 1. Crear cuenta en https://www.brevo.com/ (plan gratuito permanente)
# 2. Generar API Key en Settings > API Keys > Generate a new API key
# 3. Seleccionar "SMTP" o "Full Access"
# 4. Copiar la API Key (empieza con xkeysib-)
# Plan gratuito: 300 emails/día permanentemente
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=tu_email@urbanfix.com
MAIL_PASSWORD=xkeysib-tu-api-key-aqui
