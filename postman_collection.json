            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/v1/categorias/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "categorias", "1"]
            },
            "description": "Elimina una categoría. Requiere rol ADMIN_MUNICIPAL."
          },
          "response": []
